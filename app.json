{
  "expo": {
    "name": "A2Imoveis",
    "slug": "A2Imoveis",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para enviar imagens do imóvel e do comprovante.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "br.com.a2imoveiscriciuma.app",
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.a2imoveiscriciuma.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    }
  }
}
